import assert from 'node:assert/strict';
import { resolveContrastIncomplete, zoneOf } from './release/tools/visibility.mjs';
import { printShown, screenWidths, resolveReveals } from './release/tools/width-screen.mjs';
const path = 'body:1/main:0/p:0';
const vis = { byElement: { [path]: { complete: true, min: 10 } } };
const review = { id:'wcag-review',decision:'PASS',artifact:'shot.png',worstRegion:'The first line over the lightest background' };
const run = (on,off,r=review) => resolveContrastIncomplete({ incomplete:[{id:'color-contrast'}], paths:[{path,large:false}],integrity:{probeWorld:{visibility:vis},jsOff:{visibility:vis},glyph:{scripted:{[path]:{ratio:on}},jsOff:{[path]:{ratio:off}}}},review:r,shots:['shot.png'] });
for (const [a,b] of [[8,8],[2,8],[3.5,8],[null,8],[8,null],[null,null]]) console.log('resolver',a,b,JSON.stringify(run(a,b)));
console.log('null without review',run(null,8,null).pass);
