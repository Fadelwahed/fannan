codex
I found a false-positive path in the glyph measure: the 75% coverage cutoff includes CSS opacity, so readable captions at `opacity: .7` can have no measured glyphs and remain blocked. I’m checking that calculation in memory, along with cases where the width matcher may overlook a lost control.

exec
/bin/bash -lc "node --input-type=module <<'JS'
import { glyphRatio, resolveContrastIncomplete } from './release/tools/visibility.mjs';
const img = (w,h,f) => { const rgb=new Uint8Array(w*h*3); for(let y=0;y<h;y++)for(let x=0;x<w;x++)rgb.set(f(x,y),(y*w+x)*3);return {width:w,height:h,rgb}; };
const glyph=(x,y)=>x>=1&&x<=6&&y>=1&&y<=8;
const off=img(8,10,()=>[0,0,0]);
const on=img(8,10,(x,y)=>glyph(x,y)?[178,178,178]:[0,0,0]);
const r=glyphRatio(on,off,{black:off,white:on});
const lum = c => ((c/255+0.055)/1.055)**2.4;
console.log(JSON.stringify({case:'white text opacity .7 on black image',physicalContrast:(lum(178)+.05)/.05,glyph:r}));
const vis={byElement:{p:{complete:true}}};
console.log(JSON.stringify(resolveContrastIncomplete({incomplete:[{id:'color-contrast'}],paths:[{path:'p',target:['p'],large:false}],integrity:{probeWorld:{visibility:vis},jsOff:{visibility:vis},glyph:{scripted:{p:r},jsOff:{p:r}}},review:{id:'wcag-review',decision:'PASS',artifact:'shot.png'},shots:['shot.png']})));
