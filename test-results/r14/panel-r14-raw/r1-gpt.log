/bin/bash -lc 'nl -ba release/references/design-quality.md; nl -ba release/references/critic-rubric.md; nl -ba release/references/handoff-contract.md; nl -ba release/memory/FANNAN-MEMORY-PROPOSED.md' in /workspace/panel-r14/fannan
