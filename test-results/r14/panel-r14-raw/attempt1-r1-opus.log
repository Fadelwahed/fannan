{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WJZU7hP9wieUYAruuiDQXe","type":"tool_result","content":"1\t// pre-handoff-check.mjs: Fannan's Harden gate (project arg, protected external dependencies and executables). Local files only; all network requests blocked.\n2\t// Usage: FANNAN_DEPS=<npm prefix> node pre-handoff-check.mjs <DESIGN.md> <page.html> <evidence-dir> <project>\n3\t// Checks: (1) design.md lint 0 errors, (2) axe-core WCAG 2.0/2.1/2.2 A and AA tags (axe-tags.mjs) with target-size ENABLED, 0 violations,\n4\t// (3) custom WCAG 2.2: 2.4.11 focus not obscured, 2.5.8 targets >= 24x24, reduced motion = no running animation,\n5\t// focus visible on every tab stop, every declared desktop width + 320 px reflow screened, (4) impeccable detect (advisory). Writes evidence.json + screenshot.\n6\timport { readFileSync, existsSync, realpathSync, mkdtempSync, rmSync } from 'node:fs';\n7\timport { tmpdir } from 'node:os';\n8\timport { createHash } from 'node:crypto';\n9\timport { execFileSync } from 'node:child_process';\n10\timport { pathToFileURL, fileURLToPath } from 'node:url';\n11\timport { dirname, join, resolve } from 'node:path';\n12\timport { checkHandoff, qualityChecks } from './handoff-contract.mjs';\n13\timport { verifiedDeps } from './verify-deps.mjs';\n14\timport { localAsset } from './local-file-boundary.mjs';\n15\timport { copySignals } from './copy-signals.mjs';\n16\timport { verifiedBrowser, browserLaunchEnv } from './executable-trust.mjs';\n17\timport { focusSettle, focusStyleProbe, focusBaseline } from './focus-screen.mjs';\n18\timport { spacingProbe, approvedSpacing, approvedAccent } from './spacing-scale.mjs';\n19\timport { designProbe, rawGlass, normColour, accentCheck } from './design-probe.mjs';\n20\timport { screenWidths, resolveReflowCandidates, validWidths } from './width-screen.mjs'; // R8, ported from codex/fannan-r3-review 2733317\n21\timport { axeOptions } from './axe-tags.mjs';\n22\timport { isolatedPage } from './probe-world.mjs';\n23\timport { nativeCheck, compareIntegrity, contrastProbe, contentProbe, rafCounterInit, rafLoopFrom } from './integrity.mjs';\n24\timport { scopeOf, resolveScoped } from './exceptions.mjs';\n25\tconst here = dirname(fileURLToPath(import.meta.url));\n26\tconst [, , designMd, page, outDir, project, handoffPath, phaseArg] = process.argv;\n27\tif (!designMd || !page || !outDir || !project || !handoffPath || (phaseArg && !['--phase=wireframe', '--phase=handoff'].includes(phaseArg))) { console.error('usage: FANNAN_DEPS=<npm prefix> node pre-handoff-check.mjs <DESIGN.md> <page.html> <evidence-dir> <project> <handoff.json> [--phase=wireframe|handoff]'); process.exit(2); }\n28\tconst phase = phaseArg?.split('=')[1] || 'handoff';\n29\tconst q = qualityChecks.thresholds;\n30\tconst [nodeMajor, nodeMinor] = process.versions.node.split('.').map(Number);\n31\tif (nodeMajor < 22 || (nodeMajor === 22 && nodeMinor < 12)) { console.error('pre-handoff-check: Node 22.12+ is required (package.json engines); found ' + process.versions.node); process.exit(2); }\n32\t// npm deps live in protected storage OUTSIDE the manifest-covered tree (N2).\n33\tconst releaseRoot = realpathSync(join(here, '..'));\n34\tlet depsRoot;\n35\ttry { depsRoot = verifiedDeps(process.env.FANNAN_DEPS, releaseRoot); }\n36\tcatch (e) { console.error('pre-handoff-check: dependencies untrusted: ' + e.message); process.exit(2); }\n37\tlet chromium;\n38\ttry { ({ chromium } = await import(pathToFileURL(join(depsRoot, 'node_modules/playwright-core/index.mjs')).href)); }\n39\tcatch (e) { console.error('pre-handoff-check: playwright-core missing from FANNAN_DEPS: ' + e.message); process.exit(2); }\n40\t// A fresh evidence directory prevents clobbering an earlier review; each output uses safe-write.\n41\tif (existsSync(outDir)) { console.error('pre-handoff-check: evidence directory already exists; use a fresh versioned path'); process.exit(2); }\n42\tconst evidenceWrite = (name, value) => execFileSync(join(here, 'safe-write.sh'), [project, join(resolve(outDir), name)], { input: value });\n43\tconst digest = value => createHash('sha256').update(value).digest('hex');\n44\ttry { execFileSync(join(here, 'readonly-precheck.sh'), [resolve(outDir) + '/evidence.json', project], { encoding: 'utf8' }); }\n45\tcatch (e) { console.error('pre-handoff-check: readonly-precheck refused the evidence folder: ' + String(e.stderr || e.message).trim()); process.exit(2); }\n46\tconst ev = { when: new Date().toISOString(), designMd: resolve(designMd), page: resolve(page), checks: {} };\n47\tlet fail = false;\n48\tlet handoff;\n49\ttry { handoff = JSON.parse(readFileSync(handoffPath, 'utf8')); ev.checks.contract = { errors: checkHandoff(handoff, phase) }; }\n50\tcatch (e) { ev.checks.contract = { errors: [`handoff JSON cannot be read: ${e.message}`] }; }\n51\tev.checks.contract.pass = ev.checks.contract.errors.length === 0;\n52\tif (!ev.checks.contract.pass) fail = true;\n53\t// CODEX-R3-02: the approved spacing scale comes from the hash-checked handoff token JSON, never from the page.\n54\tconst approvedScale = approvedSpacing(handoff);\n55\tev.checks.spacingTokens = { source: approvedScale.source ?? null, values: approvedScale.values, error: approvedScale.error, pass: !approvedScale.error };\n56\tif (phase === 'handoff' && !ev.checks.spacingTokens.pass) fail = true;\n57\t// R11 panel D1 (decision A): the accent must be the approved palette token; FAIL at handoff, DEFERRED in wireframes.\n58\tconst approvedAccentToken = approvedAccent(handoff);\n59\tconst accentFor = async (pg, d) => accentCheck({ design: d, approved: approvedAccentToken, pageColour: await pg.evaluate(normColour, d.accent), approvedColour: approvedAccentToken.value ? await pg.evaluate(normColour, approvedAccentToken.value) : null, phase });\n60\t// 1 lint\n61\ttry {\n62\t  const r = execFileSync(process.execPath, [join(depsRoot, 'node_modules/@google/design.md/dist/index.js'), 'lint', designMd], { encoding: 'utf8' });\n63\t  const j = JSON.parse(r.slice(r.indexOf('{'))); const errors = j.summary?.errors ?? j.errors ?? null;\n64\t  ev.checks.lint = { errors, pass: errors === 0 }; if (errors !== 0) fail = true;\n65\t} catch (e) { ev.checks.lint = { pass: false, error: String(e.stdout || e.message).slice(0, 400) }; fail = true; }\n66\t// 2-3 browser checks\n67\tlet axeSrc;\n68\ttry { axeSrc = readFileSync(join(depsRoot, 'node_modules/axe-core/axe.min.js'), 'utf8'); }\n69\tcatch (e) { console.error('pre-handoff-check: axe-core missing from FANNAN_DEPS: ' + e.message); process.exit(2); }\n70\tconst browserHome = mkdtempSync(join(tmpdir(), 'fannan-browser-home-')); // ARGON-R2-06: private HOME, removed on exit\n71\tprocess.on('exit', () => rmSync(browserHome, { recursive: true, force: true }));\n72\tlet browserIdentity;\n73\ttry { browserIdentity = verifiedBrowser(); }\n74\tcatch (e) { console.error('pre-handoff-check: browser untrusted: ' + e.message); process.exit(2); }\n75\tconst b = await chromium.launch({ executablePath: browserIdentity.path, chromiumSandbox: true, env: browserLaunchEnv(browserHome) });\n76\tconst runtimeVersion = b.version();\n77\tif (runtimeVersion !== browserIdentity.version) { console.error(`pre-handoff-check: browser version ${runtimeVersion} does not match reviewed pin ${browserIdentity.version}`); await b.close(); process.exit(2); } // R4-4\n78\tev.browser = { ...browserIdentity, version: runtimeVersion };\n79\tconst ctx = await b.newContext({ viewport: { width: 1440, height: 900 }, serviceWorkers: 'block' });\n80\tawait ctx.routeWebSocket(/.*/, ws => ws.close());\n81\tconst blocked = [];\n82\tconst OUTPUT_BASE = '/workspace/design-output';\n83\tconst projectRoot = join(OUTPUT_BASE, project);\n84\tconst glassFiles = new Set(); // R11 S2: served CSS/HTML that declares a backdrop filter (Chrome drops the -webkit- alias)\n85\t// R11: served CSS, HTML, SVG and JavaScript text (constructed sheets and script-set styles; Chrome drops the -webkit- alias w