{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SZEyhEwyHEzjHmXEDSSbfL","type":"tool_result","content":"1\t// R13 (panel round 13): regressions for the browser items. Each real-Chrome case was first run against the f9a8d7e\n2\t// sources and reached its assertion there (test-results/r13/repro-before.log); see reviews/MIMAR-R13-changes-*.md.\n3\timport test from 'node:test';\n4\timport assert from 'node:assert/strict';\n5\timport { existsSync, readFileSync } from 'node:fs';\n6\timport { createRequire } from 'node:module';\n7\timport { dirname, join, resolve } from 'node:path';\n8\timport { fileURLToPath } from 'node:url';\n9\timport { rawGlass, designProbe } from '../tools/design-probe.mjs';\n10\timport { screenWidths } from '../tools/width-screen.mjs';\n11\timport { spacingProbe } from '../tools/spacing-scale.mjs';\n12\timport { rafCounterInit, rafLoopFrom, nativeCheck, contentProbe } from '../tools/integrity.mjs';\n13\t\n14\tconst release = resolve(dirname(fileURLToPath(import.meta.url)), '..');\n15\tconst deps = process.env.FANNAN_DEPS || resolve(release, '..', 'runtime-deps');\n16\tconst chrome = process.env.FANNAN_TEST_CHROME || '/usr/bin/google-chrome';\n17\tconst haveChrome = existsSync(join(deps, 'node_modules/playwright-core')) && existsSync(chrome);\n18\tconst skip = !haveChrome && 'test-only deps or local Chrome absent';\n19\tconst withBrowser = async fn => {\n20\t  const { chromium } = createRequire(join(deps, 'node_modules/'))('playwright-core');\n21\t  const browser = await chromium.launch({ executablePath: chrome, args: ['--headless=new'] });\n22\t  try { await fn(browser); } finally { await browser.close(); }\n23\t};\n24\tconst screen = async (page, html, width, body = 'margin:0') => {\n25\t  await page.setContent(`<html lang=\"en\"><body style=\"${body}\"><main><h1>Page</h1>${html}</main></body></html>`); await page.waitForTimeout(50);\n26\t  return (await screenWidths(page, [1440], { lang: 'en', dir: 'ltr' })).results.find(r => r.width === width);\n27\t};\n28\t\n29\ttest('R13 N08/N09: JavaScript escapes are decoded and comment markers inside strings cannot hide glass (cheap defence)', () => {\n30\t  for (const t of [\"el.style.setProperty('-webkit-backdrop\\\\x2dfilter','blur(4px)')\", \"el.style.webkitBackdrop\\\\u0046ilter='blur(4px)'\", \"el.style.setProperty('backdrop\\\\u{2d}filter','blur(4px)')\", 'const a=\"/*\"; el.style.webkitBackdropFilter=\"blur(4px)\"; const b=\"*/\";']) assert.equal(rawGlass(t, 'script'), true, t);\n31\t  assert.equal(rawGlass('const css = \".a{backdrop\\\\x2dfilter: none}\";', 'script'), false, 'an explicit none stays allowed after decoding');\n32\t  assert.equal(rawGlass('/* .a{-webkit-backdrop-filter: blur(6px)} */ .b{color:red}'), false, 'a real CSS comment is still stripped');\n33\t});\n34\t\n35\ttest('R13 N07: data: and blob: stylesheets are refused and unreadable unserved ones fail, on the page and on every state', () => {\n36\t  const source = readFileSync(join(release, 'tools/pre-handoff-check.mjs'), 'utf8');\n37\t  assert.match(source, /refused = list\\.filter\\(x => \\/\\^\\(data\\|blob\\):\\/i\\.test\\(x\\.href \\|\\| ''\\)\\)/);\n38\t  assert.match(source, /unscanned = list\\.filter\\(x => !x\\.readable && !refused\\.includes\\(x\\) && !\\(x\\.href && served\\.has\\(x\\.href\\)\\)\\)/);\n39\t  assert.match(source, /&& stylesheets\\.pass && integrity\\.pass/);\n40\t  assert.match(source, /stylesheetsUnscanned: sheetsCheck\\(d\\)\\.refused\\.length \\+ sheetsCheck\\(d\\)\\.unscanned\\.length/);\n41\t});\n42\t\n43\ttest('R13 N04/q1: every nested-document element is a frame for the probes and the width screen', () => {\n44\t  for (const f of ['tools/design-probe.mjs', 'tools/width-screen.mjs']) assert.match(readFileSync(join(release, f), 'utf8'), /'iframe, frame, object, embed, fencedframe, portal'/, f);\n45\t  assert.doesNotMatch(readFileSync(join(release, 'tools/handoff-contract.mjs'), 'utf8'), /frameExceptions/, 'q1: no frame exceptions');\n46\t});\n47\t\n48\ttest('R13 N01/N02/N03/N04/N15/N16: real Chrome: the width screen sees body-clipped, zero-box, shadow-clipped and nested-scope content (test-only)', { skip }, async () => withBrowser(async browser => {\n49\t  const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });\n50\t  for (const w of [1440, 320]) {\n51\t    // N01: body overflow-x:hidden propagates to the viewport; content pushed past the left edge is off-screen.\n52\t    for (const p of ['<p style=\"margin-left:-400px\">Pushed left text</p>', '<p style=\"transform:translateX(-400px)\">Translated text</p>']) {\n53\t      const r = await screen(page, p, w, 'margin:0;overflow-x:hidden');\n54\t      assert.deepEqual([r.pass, r.offscreenLeft.length], [false, 1], `N01 @${w} ${p}`);\n55\t    }\n56\t  }\n57\t  // N02: zero-size and display:contents boxes still hold text.\n58\t  const contents = await screen(page, `<div style=\"overflow-x:auto\"><span style=\"display:contents;white-space:nowrap\">${'contents text '.repeat(60)}</span></div>`, 320);\n59\t  assert.deepEqual([contents.pass, contents.scrolledText.length], [false, 1], 'N02 display:contents');\n60\t  const zero = await screen(page, `<div style=\"overflow-x:auto\"><span style=\"display:inline-block;width:0;height:0;white-space:nowrap\">${'zero box text '.repeat(60)}</span></div>`, 320);\n61\t  assert.deepEqual([zero.pass, zero.scrolledText.length], [false, 1], 'N02 0x0 inline-block');\n62\t  const flat = await screen(page, '<h2 style=\"height:0;margin:0 0 0 -400px\">Zero height heading</h2>', 1440);\n63\t  assert.deepEqual([flat.pass, flat.offscreenLeft.length], [false, 1], 'N02 height:0 heading');\n64\t  const sr = await screen(page, '<span style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)\">Skip to content</span>', 320);\n65\t  assert.equal(sr.pass, true, 'N02: a real screen-reader-only label is still exempt');\n66\t  // N03: open shadow text clipped by its host's left edge.\n67\t  const shadow = await screen(page, `<div id=\"h\" style=\"overflow:hidden;width:300px;margin-left:100px\"></div><script>document.getElementById('h').attachShadow({mode:'open'}).innerHTML='<p style=\"margin-left:-200px;white-space:nowrap\">Shadow text cut off at the left</p>';</script>`, 1440);\n68\t  assert.deepEqual([shadow.pass, shadow.clipped.length], [false, 1], 'N03');\n69\t  // N04: object/embed are nested scopes the screen cannot enter.\n70\t  const obj = await screen(page, '<object type=\"text/html\" data=\"data:text/html,<p>x</p>\" width=\"200\" height=\"100\"></object>', 320);\n71\t  assert.deepEqual([obj.pass, obj.unscannedScopes.length], [false, 1], 'N04 object');\n72\t  await page.setContent('<main><h1>x</h1><object type=\"text/html\" data=\"data:text/html,<p>x</p>\" width=\"200\" height=\"100\"></object><embed src=\"data:text/html,<p>y</p>\" width=\"200\" height=\"100\"></main>'); await page.waitForTimeout(200);\n73\t  assert.equal((await page.evaluate(designProbe)).glassScopes.unscannedFrames.length, 2, 'N04: object and embed are counted as frames');\n74\t  // N15: one link in the first cell is not keyboard reach across a 340px table.\n75\t  const table = await screen(page, '<div style=\"overflow-x:auto;width:320px\"><table id=\"t\" style=\"width:340px;border-collapse:collapse\"><tr><td style=\"padding:0\"><a href=\"#a\" style=\"display:inline-block;width:40px\">link</a></td><td style=\"padding:0;text-align:right\">far</td></tr></table></div>', 320);\n76\t  assert.deepEqual([table.pass, table.reflowCandidates.map(c => c.keyboard)], [false, [false]], 'N15');\n77\t  // N16: a closed shadow root is an unscanned scope.\n78\t  const closed = await screen(page, `<div id=\"c\"></div><script>document.getElementById('c').attachShadow({mode:'closed'}).innerHTML='<div style=\"overflow-x:auto\"><p style=\"width:900px\">${'closed text '.repeat(20)}</p></div>';</script>`, 320);\n79\t  assert.deepEqual([closed.pass, closed.unscannedScopes.map(s => s.src)], [false, ['closed shadow root']], 'N16');\n80\t  const plain = await screen(page, '<p>Plain text</p>', 320);\n81\t  assert.equal(plain.pass, true, 'a plain page still passes');\n82\t}));\n83\t\n84\ttest('R13 N17: real Chrome: a page that patches Function.prototype.call cannot capture the native rAF; the patch is a tamper sign (test-only)', { skip }, async () => withBrowser(async browser => {\n85\t  const ctx = await browser.newContext(); await ctx.addInitScript(rafCounterInit); const pg = await ctx.newPage();\n86\t  await pg.setContent(`<main><h1>x</h1></main><script>let nat; const oc = Function.prototype.call; Function.prototype.call = function (...a) { nat = this; return oc.apply(this, a); }; requestAnimationFrame(() => {}); Function.prototype.call = oc; window.__captured = typeof nat === 'function'; const loop = () => nat.apply(window, [loop]); if (nat) loop();</script>`);\n87\t  assert.equal(await pg.evaluate(() => window.__captured), false, 'the wrapper never looks up Function.prototype.call');\n88\t  const loopPage = await ctx.newPage();\n89\t  await loopPage.setContent('<main><h1>x</h1></main><script>const loop = () => requestAnimationFrame(loop); loop();</script>');\n90\t  const a = await loopPage.evaluate(() => window.__raf); await loopPage.waitForTimeout(400); const b = await loopPage.evaluate(() => window.__raf);\n91\t  assert.equal(rafLoopFrom(a, b), true, 'an ordinary loop is still counted');\n92\t  const patched = await ctx.newPage();\n93\t  await patched.setContent('<main><h1>x</h1></main><script>Function.prototype.call = function (...a) { return Reflect.apply(this, a[0], a.slice(1)); };</script>');\n94\t  assert.deepEqual(await patched.evaluate(nativeCheck), ['Function.prototype.call']);\n95\t}));\n96\t\n97\ttest('R13 N20/N13: real Chrome: spacing, placeholders, h1 and the content record include open shadow roots (test-only)', { skip }, async () => withBrowser(async browser => {\n98\t  const page = await browser.newPage();\n99\t  await page.setContent(`<main><h1