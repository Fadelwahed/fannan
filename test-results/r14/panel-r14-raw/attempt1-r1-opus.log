{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017ncTMYCjRsk4asGYKXkP97","type":"tool_result","content":"1\timport { resolveScoped } from './exceptions.mjs';\n2\t// width-screen.mjs: R8, ported from codex/fannan-r3-review 2733317 (release/tools/browser-probes.mjs screenWidths/inspectLayout).\n3\t// Screening only: renders the page at every declared desktop width plus 320 CSS px (desktop 400% reflow equivalent) and\n4\t// flags horizontal overflow, clipped or ellipsised text, and a language/direction mismatch. Actual zoom, text spacing,\n5\t// WCAG reflow exceptions and layout quality still need manual evidence. 320 px is not a mobile design approval.\n6\texport const REFLOW_WIDTH = 320;\n7\t\n8\t// R11 (Asad panel S3, panel D1 decision B): WCAG 1.4.10 excuses only the smallest region whose usage or meaning needs a\n9\t// two-dimensional layout. At the 320 px reflow width, ordinary text or media that overflows a sideways scroller (left\n10\t// or right) fails. A table, pre, code, role=grid/table with real rows, or an element marked data-fannan-2d=\"<reason>\"\n11\t// is only a CANDIDATE: it is recorded with its element and reason, never excused automatically. A candidate's\n12\t// scroller must fit inside 320 px and be keyboard-usable (tabindex or a focusable child), and an unresolved candidate\n13\t// blocks the final handoff (resolveReflowCandidates). Resizable media (img, svg, video, canvas, iframe) is not a\n14\t// candidate unless it sits inside a marked data-fannan-2d region. No count caps.\n15\texport const TWO_D = 'table, pre, code, [role=\"grid\"], [role=\"table\"], [data-fannan-2d]';\n16\t\n17\texport function inspectLayout({ reflow = false } = {}) {\n18\t  const TWO_D = 'table, pre, code, [role=\"grid\"], [role=\"table\"], [data-fannan-2d]';\n19\t  const MEDIA = 'img, svg, video, canvas, iframe, frame, object, embed, fencedframe, portal, input, select, textarea, button';\n20\t  const NESTED = 'iframe, frame, object, embed, fencedframe, portal';\n21\t  const clipped = [], offscreenLeft = [], unreachable = [], scrolledText = [], reflowCandidates = [], unmeasured = [], unscannedScopes = [];\n22\t  // ARGON-R5-05: visually hidden (sr-only) content is not a clip: clip: rect(0...) / clip-path inset(50%), or a box of at\n23\t  // most 1x1 px. R13 N02: the tiny box counts as sr-only only when it also clips (overflow hidden/clip); text that\n24\t  // overflows a zero-size visible box is rendered and measured.\n25\t  const srOnly = (r, c) => (r.width <= 1 && r.height <= 1 && (['hidden', 'clip'].includes(c.overflowX) || ['hidden', 'clip'].includes(c.overflowY))) || /^rect\\(0(px)?,? 0(px)?,? 0(px)?,? 0(px)?\\)$/.test(c.clip) || c.clipPath === 'inset(50%)';\n26\t  const focusable = e => e.matches('a[href], button, input, select, textarea, summary, [tabindex]:not([tabindex=\"-1\"])');\n27\t  const label = el => el.tagName.toLowerCase() + (el.id ? `#${el.id}` : '');\n28\t  // R12 M11: the composed tree. Open shadow roots are walked (they share the page's coordinates); parents follow slots\n29\t  // and shadow hosts. Same-origin frames are measured as documents; a frame that cannot be read is an unscanned scope.\n30\t  const parentOf = el => el.assignedSlot ?? el.parentElement ?? (el.getRootNode() instanceof ShadowRoot ? el.getRootNode().host : null);\n31\t  const all = [];\n32\t  const walk = root => { for (const el of root.querySelectorAll('*')) { all.push(el); if (el.shadowRoot) walk(el.shadowRoot); } };\n33\t  if (document.body) { all.push(document.body); walk(document.body); }\n34\t  const within = (s, d) => { for (let a = d; a; a = parentOf(a)) if (a === s) return true; return false; };\n35\t  const ownText = el => [...el.childNodes].some(n => n.nodeType === 3 && n.nodeValue.trim());\n36\t  // the content itself is measured (text-node ranges, or the media box), so text overflowing its own box counts too\n37\t  const textRects = el => [...el.childNodes].filter(n => n.nodeType === 3 && n.nodeValue.trim()).map(n => { const range = document.createRange(); range.selectNodeContents(n); return range.getBoundingClientRect(); }).filter(b => b.width > 0 && b.height > 0);\n38\t  const contentRects = el => el.matches(MEDIA) ? [el.getBoundingClientRect()] : textRects(el);\n39\t  // R12 M14, R13 N02: hidden, undisplayed or sr-only content (on the element or a composed ancestor) is never\n40\t  // measured. Visibility comes from computed style plus geometry: an element box, or (display:contents, zero-size\n41\t  // boxes) its rendered text ranges.\n42\t  const srHidden = new Map();\n43\t  const inSrOnly = el => { if (!el) return false; if (srHidden.has(el)) return srHidden.get(el); const v = srOnly(el.getBoundingClientRect(), getComputedStyle(el)) || inSrOnly(parentOf(el)); srHidden.set(el, v); return v; };\n44\t  const shown = el => { const c = getComputedStyle(el); if (c.display === 'none' || c.visibility !== 'visible' || inSrOnly(el)) return false; const r = el.getBoundingClientRect(); return (r.width > 0 && r.height > 0) || textRects(el).length > 0; };\n45\t  const isContent = el => el.matches(MEDIA) || ownText(el);\n46\t  // R13 N03: composed content detection: an element holds content when it or any composed descendant (open shadow\n47\t  // trees included) is shown text or media, so a shadow-only host is screened too.\n48\t  const holds = new Set();\n49\t  for (const d of all) if (isContent(d) && shown(d)) for (let a = d; a && !holds.has(a); a = parentOf(a)) holds.add(a);\n50\t  // R13 N01: body's overflow propagates to the viewport when html's is visible; body is then not a scroll or clip box\n51\t  // (the viewport is), so content pushed left of it is offscreenLeft.\n52\t  const rootStyle = getComputedStyle(document.documentElement);\n53\t  const bodyPropagates = rootStyle.overflowX === 'visible' && rootStyle.overflowY === 'visible';\n54\t  const clipBox = a => a !== document.documentElement && !(a === document.body && bodyPropagates);\n55\t  const overflowX = el => getComputedStyle(el).overflowX;\n56\t  const scrollerOf = el => { for (let a = parentOf(el); a && a !== document.documentElement; a = parentOf(a)) if (clipBox(a) && overflowX(a) !== 'visible') return a; return null; };\n57\t  // R12 M02: the horizontal range a scroller can show. scrollLeft runs 0..max (LTR) or -max..0 (RTL); hidden/clip boxes\n58\t  // show only their inner box. Content outside this range is lost on either edge, whatever scrollWidth says.\n59\t  const reach = s => {\n60\t    const b = s.getBoundingClientRect(), left = b.left + s.clientLeft, right = left + s.clientWidth;\n61\t    if (!['auto', 'scroll'].includes(overflowX(s))) return { left, right, inner: { left, right } };\n62\t    const max = Math.max(0, s.scrollWidth - s.clientWidth), rtl = getComputedStyle(s).direction === 'rtl';\n63\t    const min = rtl ? -max : 0, top = rtl ? 0 : max, cur = s.scrollLeft;\n64\t    return { left: left + min - cur, right: right + top - cur, inner: { left, right } };\n65\t  };\n66\t  const beyond = (e, r) => all.some(d => d !== e && holds.has(d) && within(e, d) && [...(shown(d) && d.getBoundingClientRect().width > 0 ? [d.getBoundingClientRect()] : []), ...contentRects(d)].some(b => b.right > r.right + 1 || b.left < r.left - 1)); // R13 N03: composed ancestry and content\n67\t  // ARGON-R5-02: body is screened too, so html + body overflow hidden/clip cannot hide a wide layout.\n68\t  for (const e of all) {\n69\t    const c = getComputedStyle(e), r = e.getBoundingClientRect();\n70\t    if (!holds.has(e)) continue; // R13 N02/N03: shown, and holds shown text or media (composed)\n71\t    // overflow: clip makes no scroll container, so scrollWidth stays at clientWidth; measure what the box cuts off instead.\n72\t    // R12 M02: hidden boxes are measured the same way, so content pushed past their LEFT edge is a clip too.\n73\t    const x = (e.scrollWidth > e.clientWidth + 1 && ['hidden', 'clip'].includes(c.overflowX)) || (clipBox(e) && ['hidden', 'clip'].includes(c.overflowX) && beyond(e, r));\n74\t    const y = e.scrollHeight > e.clientHeight + 1 && ['hidden', 'clip'].includes(c.overflowY);\n75\t    // CODEX-R4-04: ellipsis styling alone is not a clip; only text that actually overflows a hidden/clip box is recorded.\n76\t    if ((x || y)) clipped.push({ tag: e.tagName, slot: e.getAttribute('data-copy-slot'), x, y, ellipsis: x && c.textOverflow === 'ellipsis' });\n77\t    const s = scrollerOf(e);\n78\t    // ARGON-R5-05: text or media pushed past the left edge of the page is lost (no scrollbar reaches it). Exempt: the\n79\t    // off-screen skip-link pattern (a focusable absolute/fixed element wholly left of the viewport that appears on\n80\t    // focus; the focus probe checks it is visible when focused). Inside a scroller, R12 M02 measures its range instead.\n81\t    const left = Math.min(r.width > 0 ? r.left : Infinity, ...contentRects(e).map(b => b.left)); // R13 N02: zero-size boxes by their text\n82\t    if (!s && left < -1 && e !== document.body && !(focusable(e) && ['absolute', 'fixed'].includes(c.position) && r.right <= 0)) offscreenLeft.push({ tag: e.tagName, slot: e.getAttribute('data-copy-slot'), left: Math.round(left) });\n83\t    if (s && ['auto', 'scroll'].includes(overflowX(s)) && (isContent(e) || ['auto', 'scroll'].includes(c.overflowX))) {\n84\t      const range = reach(s), rects = isContent(e) ? contentRects(e) : [r];\n85\t      const side = rects.some(b => b.left < range.left - 1) ? 'left' : rects.some(b => b.right > range.right + 1) ? 'right' : null;\n86\t      if (side && !(focusable(e) && ['absolute', 'fixed'].includes(c.position))) unreachable.push({ tag: e.tagName, slot: e.getAttribute('data-copy-slot'), side, scroller: label(s) });\n87\t    }\n88\t    // R12 M11: a same-origin frame whose document scrolls sideways is screened at 320 px; an unreadable frame is unscanned.\n89\t    // R13 N04: every element that can hold a nested document (object, embed, fencedframe, portal too).\n90\t    if (e.matches(NESTED)) { let doc = null; try { doc = e.contentDocument; } catch {} if (!doc?.documentElement) unscannedScopes.push({ tag: e.tagName, src: e.getAttribute('src') || (e.hasAttribute('srcdoc') ? 'srcdoc' : '') }); else if (reflow && doc.documentElement.scrollWidth > doc.documentElement.clientWidth + 1) scrolledText.push({ tag: e.tagName, slot: e.getAttribute('data-copy-slot'), sample: 'frame document scrolls sideways' }); }\n91\t  }\n92\t  if (reflow) {\n93\t    const candidateOf = (d, scroller) => { for (let t = d.closest(TWO_D); t; t = t.parentElement?.closest(TWO_D)) { if (t !== scroller && !scroller.contains(t)) return null; if (!t.matches('[role=\"grid\"], [role=\"table\"]') || t.querySelector('[role=\"row\"]') || t.matches('[data-fannan-2d]')) return t; } return null; };\n94\t    const usable = el => shown(el) && !el.disabled && !el.closest('[inert]') && el.tabIndex >= 0;\n95\t    for (const e of all) {\n96\t      const c = getComputedStyle(e);\n97\t      if (!['auto', 'scroll'].includes(c.overflowX) || !holds.has(e)) continue; // R13 N02: a zero-size scroller holding shown text is screened\n98\t      const box = reach(e).inner;\n99\t      // R12 M01: the scroller's own text counts (bare text in a nowrap box, a directly scrollable pre), and so does\n100\t      // content in its open shadow tree; nothing is skipped because scrollWidth did not grow.\n101\t      const inside = all.filter(d => within(e, d) && shown(d) && isContent(d));\n102\t      const over = inside.filter(d => contentRects(d).some(b => b.right > box.right + 1 || b.left < box.left - 1));\n103\t      if (!over.length) {\n104\t        // fail closed: the box scrolls and visible elements stick out, but no text or media was measured there\n105\t        if (e.scrollWidth > e.clientWidth + 1 && all.some(d => d !== e && within(e, d) && shown(d) && (d.getBoundingClientRect().right > box.right + 1 || d.getBoundingClientRect().left < box.left - 1) && holds.has(d))) unmeasured.push({ tag: e.tagName, slot: e.getAttribute('data-copy-slot'), scroller: label(e) });\n106\t        continue; // otherwise only padding or empty boxes overflow\n107\t      }\n108\t      const plain = over.filter(d => !candidateOf(d, e));\n109\t      if (plain.length) { scrolledText.push({ tag: e.tagName, slot: e.getAttribute('data-copy-slot'), sample: ((ownText(plain[0]) ? [...plain[0].childNodes].filter(n => n.nodeType === 3).map(n => n.nodeValue).join('') : plain[0].tagName) || '').trim().slice(0, 60) }); continue; }\n110\t      // R12 M10: keyboard use is the scroller itself in the tab order, or usable (shown, enabled, not inert) targets\n111\t      // spaced so that tabbing through them scrolls across the whole overflowing extent. R13 N15: focusing a target\n112\t      // scrolls it just into view, so the first and last targets must reach the content edges (1 px) and each next\n113\t      // target must end within one box width of the previous one's end.\n114\t      const extent = inside.flatMap(contentRects).reduce((x, b) => ({ left: Math.min(x.left, b.left), right: Math.max(x.right, b.right) }), { left: Infinity, right: -Infinity });\n115\t      const targets = all.filter(d => d !== e && within(e, d) && focusable(d) && usable(d)).map(d => d.getBoundingClientRect()).sort((p, q) => p.left - q.left);\n116\t      const span = box.right - box.left;\n117\t      const stepped = targets.length > 0 && targets[0].left <= extent.left + 1 && targets.every((t, i) => i === 0 || t.right - targets[i - 1].right <= span) && Math.max(...targets.map(t => t.right)) >= extent.right - 1;\n118\t      const keyboard = (e.hasAttribute('tabindex') && e.tabIndex >= 0 && !e.closest('[inert]')) || stepped;\n119\t      for (const t of new Set(over.map(d => candidateOf(d, e)))) {\n120\t        const marked = t.closest('[data-fannan-2d]');\n121\t        const reason = marked ? (marked.getAttribute('data-fannan-2d') || '').trim() || null : (t.getAttribute('role') || t.tagName.toLowerCase());\n122\t        const outer = e.getBoundingClientRect();\n123\t        reflowCandidates.push({ element: label(t), id: t.id || null, reason, scroller: label(e), fits: outer.left >= -1 && outer.right <= innerWidth + 1, keyboard });\n124\t      }\n125\t    }\n126\t  }\n127\t  const root = document.documentElement, body = document.body;\n128\t  const documentWidth = Math.max(root.scrollWidth, body ? body.scrollWidth : 0);\n129\t  return { width: innerWidth, documentWidth, horizontalOverflow: documentWidth > root.clientWidth + 1, clipped, offscreenLeft, unreachable, scrolledText, reflowCandidates, unmeasured, unscannedScopes, lang: root.lang, dir: getComputedStyle(root).direction };\n130\t}\n131\t\n132\texport const validWidths = widths => Array.isArray(widths) && widths.length > 0 && widths.includes(1440) && widths.every(w => Number.isInteger(w) && w > 0) && new Set(widths).size === widths.length;\n133\t\n134\t// R13 N16: closed shadow roots cannot be reached from page script, so they are counted through the DevTools protocol\n135\t// (DOM.getDocument with pierce). Each one is an unscanned scope and fails the width screen; if the count itself\n136\t// cannot be taken, the document is an unscanned scope (fail closed).\n137\texport async function closedShadowRoots(page) {\n138\t  let session = null;\n139\t  try {\n140\t    session = await page.context().newCDPSession(page);\n141\t    const { root } = await session.send('DOM.getDocument', { depth: -1, pierce: true });\n142\t    const hosts = [];\n143\t    const walk = n => { for (const r of n.shadowRoots || []) { if (r.shadowRootType === 'closed') hosts.push(n.localName); walk(r); } for (const c of n.children || []) walk(c); if (n.contentDocument) walk(n.contentDocument); if (n.templateContent) walk(n.templateContent); };\n144\t    walk(root);\n145\t    return hosts;\n146\t  } catch { return null; } finally { if (session) await session.detach().catch(() => {}); }\n147\t}\n148\t\n149\t// expected: { lang, dir } for a declared state, or null for the positional page (language checked per state).\n150\texport async function screenWidths(page, widths, expected = null, height = 900) {\n151\t  if (!validWidths(widths)) return { results: [], pass: false, error: 'settings.desktopWidths invalid; no width screened' };\n152\t  const results = [];\n153\t  const closed = await closedShadowRoots(page);\n154\t  const closedScopes = closed === null ? [{ tag: 'DOCUMENT', src: 'closed shadow roots could not be counted' }] : closed.map(host => ({ tag: host.toUpperCase(), src: 'closed shadow root' }));\n155\t  try {\n156\t    for (const width of [...widths, ...(widths.includes(REFLOW_WIDTH) ? [] : [REFLOW_WIDTH])]) {\n157\t      await page.setViewportSize({ width, height });\n158\t      await page.evaluate(() => scrollTo(0, 0));\n159\t      const result = await page.evaluate(inspectLayout, { reflow: width === REFLOW_WIDTH });\n160\t      result.unscannedScopes.push(...closedScopes);\n161\t      const language = !expected || (result.lang === expected.lang && result.dir === expected.dir);\n162\t      results.push({ ...result, purpose: widths.includes(width) ? 'declared desktop width' : 'desktop accessibility reflow (400% of 1280); not mobile approval', pass: !result.horizontalOverflow && result.clipped.length === 0 && result.offscreenLeft.length === 0 && result.unreachable.length === 0 && result.scrolledText.length === 0 && result.unmeasured.length === 0 && result.unscannedScopes.length === 0 && result.reflowCandidates.every(c => c.fits && c.keyboard) && language });\n163\t    }\n164\t  } finally {\n165\t    await page.setViewportSize({ width: 1440, height });\n166\t  }\n167\t  return { results, pass: results.every(r => r.pass), note: 'Automated width screen only; 320 CSS px approximates a 1280 px desktop at 400% zoom. Actual zoom, text spacing and WCAG reflow exceptions still require manual evidence; every reflow candidate needs a recorded decision.' };\n168\t}\n169\t\n170\t// R11 panel D1 (decisions B, T2), R12 M09: a candidate is resolved only by a handoff `reflowExceptions` entry naming\n171\t// the same screen, state, lang and element id, a non-empty reason and a reviewer who holds the qaGate or approver role\n172\t// (exceptions.mjs). Every occurrence keeps its scope; an unresolved candidate BLOCKS the final handoff.\n173\texport function resolveReflowCandidates(candidates, handoff, phase = 'handoff') {\n174\t  const r = resolveScoped({ items: candidates.map(c => ({ screen: null, state: null, lang: null, ...c })), entries: handoff?.reflowExceptions, roles: [handoff?.settings?.roles?.qaGate, handoff?.settings?.roles?.approver], phase, what: 'reflowExceptions', shape: c => `${c.element}|${c.scroller}` });\n175\t  return { candidates: r.items, unresolved: r.unresolved, status: r.status, pass: r.pass };\n176\t}\n177\t"}]},"parent_tool_use_id":"toolu_bdrk_01DPkzkRuJaRjVw8TvQQyMje","agent_id":"ab187913895d29e5f","session_id":"f0bd072d-d495-4454-a967-3e00aaf8b556","uuid":"d900310d-09cb-4c33-8d85-47eb5b1f77cb","timestamp":"2026-10-18T02:57:37.566Z","tool_result_meta":[{"id":"toolu_bdrk_017ncTMYCjRsk4asGYKXkP97","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}],"subagent_type":"general-purpose","task_description":"Part A gate diff review"}
