{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WJgMsmtT9X4HLWRZkKgHcj","type":"tool_result","content":"1\t// R11 panel D1 (decisions C and T4), R12 M06-M08/M13/M17/M21: probe-integrity cross-checks for pre-handoff-check.mjs.\n2\t// The authoritative probes and axe run in the isolated probe world (probe-world.mjs: a CDP isolated world with its\n3\t// own globals and prototypes; Playwright has no public isolated-world evaluate, so CDP Page.createIsolatedWorld is\n4\t// used directly, Chromium only). On the positional page and on every declared state, three cross-checks run:\n5\t//  1. page world vs probe world: the full hard-fail vector (VECTOR) evaluated in the page's own world. A page that\n6\t//     patches the browser functions changes only its own world, so any difference is a tampering sign.\n7\t//  2. native functions: the page world's probe functions must still be native code (heuristic; a page can hide a\n8\t//     patch from Function.prototype.toString, which is why check 1 exists).\n9\t//  3. a JavaScript-off pass (javaScriptEnabled: false), diagnostic. First the content must be equivalent (the same\n10\t//     visible copy slots, h1 count, lang and dir); otherwise the diagnostic is INCOMPLETE and fails. Then every field\n11\t//     of the vector where the page with scripts off is worse fails, unless the handoff's `jsOffDifferences` records\n12\t//     that check for this screen, state and lang with a reason and a qaGate/approver reviewer.\n13\t// A vector that is missing a field or holds a non-finite or negative count is INCOMPLETE (never PASS). Contrast is a\n14\t// diagnostic computed by contrastProbe (axe does not complete with page scripts disabled in Chrome 155).\n15\t// R13 (panel round 13, threat model in release/FANNAN-PLAN.md): the vector is the canonical gate result (N11: every\n16\t// hard-fail input, per-width maps, ratios and scrolled-viewport accent; N12: contrast unknown and coverage), the\n17\t// content record carries slot and heading text (N13), a content difference is never PASS even with a reviewed\n18\t// waiver (N14: INCOMPLETE), tamperSigns is required (N19) and call/apply/bind/Reflect.apply are native-checked (N17).\n19\t// Browser side, page world: returns the names of probe functions that are no longer native.\n20\texport function nativeCheck() {\n21\t  const toString = Function.prototype.toString;\n22\t  const native = f => { try { return typeof f === 'function' && /\\{\\s*\\[native code\\]\\s*\\}\\s*$/.test(toString.call(f)); } catch { return false; } };\n23\t  const desc = (o, k) => Object.getOwnPropertyDescriptor(o, k);\n24\t  const fns = {\n25\t    'Function.prototype.toString': toString,\n26\t    'window.getComputedStyle': window.getComputedStyle,\n27\t    'Element.prototype.getBoundingClientRect': Element.prototype.getBoundingClientRect,\n28\t    'Range.prototype.getBoundingClientRect': Range.prototype.getBoundingClientRect,\n29\t    'Document.prototype.querySelectorAll': Document.prototype.querySelectorAll,\n30\t    'Element.prototype.querySelectorAll': Element.prototype.querySelectorAll,\n31\t    'Element.prototype.matches': Element.prototype.matches,\n32\t    'Element.prototype.getAttribute': Element.prototype.getAttribute,\n33\t    'Element.prototype.closest': Element.prototype.closest,\n34\t    'Node.prototype.textContent (get)': desc(Node.prototype, 'textContent')?.get,\n35\t    'Element.prototype.scrollWidth (get)': desc(Element.prototype, 'scrollWidth')?.get,\n36\t    'CanvasRenderingContext2D.prototype.fillStyle (set)': desc(CanvasRenderingContext2D.prototype, 'fillStyle')?.set,\n37\t    'Array.prototype.filter': Array.prototype.filter,\n38\t    // R13 N17: the rAF wrapper binds call at install time; patched invocation helpers are a tamper sign as well.\n39\t    'Function.prototype.call': Function.prototype.call,\n40\t    'Function.prototype.apply': Function.prototype.apply,\n41\t    'Function.prototype.bind': Function.prototype.bind,\n42\t    'Reflect.apply': Reflect.apply,\n43\t  };\n44\t  return Object.entries(fns).filter(([, f]) => !native(f)).map(([name]) => name);\n45\t}\n46\t\n47\t// Browser side (probe world): text whose colour against its resolved solid background falls below 4.5:1 (3:1 for\n48\t// large text). Backgrounds with images or non-sRGB colours are counted as unknown, not as passes.\n49\texport function contrastProbe() {\n50\t  const parse = v => { const m = /^rgba?\\(([\\d.]+),\\s*([\\d.]+),\\s*([\\d.]+)(?:,\\s*([\\d.]+))?\\)$/.exec(v || ''); return m ? [Number(m[1]), Number(m[2]), Number(m[3]), m[4] === undefined ? 1 : Number(m[4])] : null; };\n51\t  const over = (top, under) => top.slice(0, 3).map((c, i) => c * top[3] + under[i] * (1 - top[3])).concat(1);\n52\t  const lum = ([r, g, b]) => [r, g, b].map(c => { c /= 255; return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4; }).reduce((s, c, i) => s + c * [0.2126, 0.7152, 0.0722][i], 0);\n53\t  let failures = 0, unknown = 0, checked = 0;\n54\t  for (const el of document.querySelectorAll('body *')) {\n55\t    if (![...el.childNodes].some(n => n.nodeType === 3 && n.nodeValue.trim())) continue;\n56\t    const c = getComputedStyle(el), r = el.getBoundingClientRect();\n57\t    if (!r.width || !r.height || c.visibility === 'hidden' || c.display === 'none') continue;\n58\t    const layers = []; let known = true;\n59\t    for (let a = el; a; a = a.parentElement) { const s = getComputedStyle(a); if (s.backgroundImage !== 'none') { known = false; break; } const bg = parse(s.backgroundColor); if (!bg) { known = false; break; } if (bg[3] > 0) layers.push(bg); if (bg[3] >= 1) break; }\n60\t    const fg = parse(c.color);\n61\t    if (!known || !fg) { unknown++; continue; }\n62\t    const bg = layers.reverse().reduce((under, top) => over(top, under), [255, 255, 255, 1]);\n63\t    const text = over(fg, bg), [l1, l2] = [lum(text), lum(bg)].sort((x, y) => y - x), ratio = (l1 + 0.05) / (l2 + 0.05);\n64\t    const size = parseFloat(c.fontSize), large = size >= 24 || (size >= 18.66 && Number(c.fontWeight) >= 700);\n65\t    checked++; if (ratio < (large ? 3 : 4.5)) failures++;\n66\t  }\n67\t  return { contrastFailures: failures, contrastUnknown: unknown, contrastChecked: checked };\n68\t}\n69\t\n70\t// Browser side: what makes two renderings equivalent content. R13 N13: each visible copy slot with its normalised\n71\t// visible text, every visible heading with its level and text (open shadow roots included), the h1 count, lang and\n72\t// dir; a JavaScript-off skeleton with empty fixed-size slots is therefore not equivalent.\n73\texport function contentProbe() {\n74\t  const shown = e => { const r = e.getBoundingClientRect(), c = getComputedStyle(e); return r.width > 0 && r.height > 0 && c.visibility !== 'hidden' && c.display !== 'none'; };\n75\t  const norm = x => (x || '').replace(/\\s+/g, ' ').trim();\n76\t  const all = []; const walk = root => { for (const el of root.querySelectorAll('*')) { all.push(el); if (el.shadowRoot) walk(el.shadowRoot); } }; if (document.body) walk(document.body);\n77\t  const slots = all.filter(e => e.hasAttribute('data-copy-slot') && shown(e)).map(e => [e.getAttribute('data-copy-slot'), norm(e.innerText)]).sort((a, b) => (a[0] + '\\u0000' + a[1]).localeCompare(b[0] + '\\u0000' + b[1]));\n78\t  const headings = all.filter(e => /^H[1-6]$/.test(e.tagName) && shown(e)).map(e => [Number(e.tagName[1]), norm(e.innerText)]);\n79\t  return { slots, headings, h1: all.filter(e => e.tagName === 'H1').length, lang: document.documentElement.lang, dir: getComputedStyle(document.documentElement).direction };\n80\t}\n81\t\n82\t// R12 M13: the reduced-motion rAF counter, installed by addInitScript in every frame. The counter is private (a\n83\t// closure), exposed only through a non-writable, non-configurable getter, and requestAnimationFrame is replaced by a\n84\t// non-writable, non-configurable wrapper, so page scripts cannot reset, freeze or bypass it. Child frames report to\n85\t// the top window through a non-configurable function.\n86\texport function rafCounterInit() {\n87\t  let count = 0;\n88\t  const lock = (o, k, d) => { try { Object.defineProperty(o, k, { configurable: false, enumerable: false, ...d }); } catch {} };\n89\t  if (window === window.top) { lock(window, '__fannanRafTick', { value: () => { count++; }, writable: false }); lock(window, '__raf', { get: () => count }); }\n90\t  let tick = () => {}; try { tick = window.top.__fannanRafTick || tick; } catch {}\n91\t  // R13 N17: the native rAF is bound at install time, so no later lookup of Function.prototype.call can capture it.\n92\t  const callNative = Function.prototype.call.bind(window.requestAnimationFrame);\n93\t  lock(window, 'requestAnimationFrame', { value: function requestAnimationFrame(cb) { try { tick(); } catch {} return callNative(window, cb); }, writable: false });\n94\t}\n95\t\n96\t// R12 M13: a rAF reading that is not a finite non-negative number (tampering or a missing counter) counts as a loop.\n97\texport const rafLoopFrom = (before, after) => !(Number.isFinite(before) && Number.isFinite(after) && after >= before) || after - before > 10;\n98\t\n99\t// R13 N11/N12: the vector is the canonical gate result. Types: count (non-negative integer), flag (boolean), text\n100\t// (string or null), ratio (finite non-negative number or null; null means the gate could not measure it), widths\n101\t// (per-width counts keyed by CSS width, so {1440:1, 320:0} and {1440:0, 320:1} differ) and coverage (a count that\n102\t// must match between worlds but is never \"worse\"; zero JavaScript-off contrast coverage makes the run INCOMPLETE).\n103\texport const VECTOR = { glass: 'count', h1: 'count', placeholders: 'flag', centered: 'count', typeSizes: 'count', heroGradient: 'flag', purpleBlue: 'flag', iconRows: 'count', accent: 'text', accentRatio: 'ratio', maxViewportAccent: 'ratio', filler: 'flag', ruleOfThree: 'flag', frames: 'count', stylesheetsUnscanned: 'count', spacingOffScale: 'count', horizontalOverflow: 'widths', clipped: 'widths', offscreenLeft: 'widths', unreachable: 'widths', scrolledText: 'widths', unmeasured: 'widths', unscannedScopes: 'widths', reflowFail: 'flag', contrastFailures: 'count', contrastUnknown: 'count', contrastChecked: 'coverage' };\n104\texport const INTEGRITY_CHECKS = [...Object.keys(VECTOR), 'content'];\n105\tconst isCount = x => Number.isInteger(x) && x >= 0;\n106\tconst validField = (t, x) => t === 'count' || t === 'coverage' ? isCount(x) : t === 'flag' ? typeof x === 'boolean' : t === 'text' ? typeof x === 'string' || x === null : t === 'ratio' ? x === null || (typeof x === 'number' && Number.isFinite(x) && x >= 0) : !!x && typeof x === 'object' && !Array.isArray(x) && Object.keys(x).length > 0 && Object.entries(x).every(([w, n]) => /^\\d+$/.test(w) && isCount(n));\n107\tconst validVector = v => !!v && typeof v === 'object' && Object.entries(VECTOR).every(([k, t]) => validField(t, v[k]));\n108\tconst validContent = c => !!c && Array.isArray(c.slots) && c.slots.every(x => Array.isArray(x) && x.length === 2 && x.every(y => typeof y === 'string')) && Array.isArray(c.headings) && c.headings.every(x => Array.isArray(x) && x.length === 2 && Number.isInteger(x[0]) && typeof x[1] === 'string') && isCount(c.h1) && typeof c.lang === 'string' && typeof c.dir === 'string';\n109\tconst canon = x => JSON.stringify(x && typeof x === 'object' && !Array.isArray(x) ? Object.keys(x).sort((a, b) => a - b).map(k => [k, x[k]]) : x);\n110\tconst worseOff = (k, on, off) => {\n111\t  const t = VECTOR[k], a = on[k], b = off[k];\n112\t  if (t === 'count') return b > a;\n113\t  if (t === 'flag') return b && !a;\n114\t  if (t === 'text') return b !== a;\n115\t  if (t === 'ratio') return (a !== null && b === null) || (a !== null && b !== null && b > a + 1e-9);\n116\t  if (t === 'widths') return canon(Object.keys(a).sort()) !== canon(Object.keys(b).sort()) || Object.keys(b).some(w => b[w] > a[w]);\n117\t  return false; // coverage\n118\t};\n119\tconst nonempty = x => typeof x === 'string' && !!x.trim();\n120\t\n121\t// Node side. probe = isolated world, page = page world, jsOff = isolated world with page scripts disabled; each is\n122\t// { vector, content }. tamperSigns from nativeCheck (R13 N19: required; omitted, undefined or null is INCOMPLETE);\n123\t// scope = { screen, state, lang } of the rendering.\n124\texport function compareIntegrity({ probe, page, jsOff, tamperSigns, handoff, scope = { screen: null, state: null, lang: null } }) {\n125\t  const base = { scope, probeWorld: probe, pageWorld: page, jsOff, tamperSigns: tamperSigns ?? null };\n126\t  const incomplete = [probe, page, jsOff].flatMap((run, i) => [validVector(run?.vector) ? null : `${['probe world', 'page world', 'JavaScript off'][i]} vector incomplete`, validContent(run?.content) ? null : `${['probe world', 'page world', 'JavaScript off'][i]} content record incomplete`]).filter(Boolean);\n127\t  if (!Array.isArray(tamperSigns)) incomplete.push('native-function check incomplete');\n128\t  if (incomplete.length) return { ...base, mismatches: [], incomplete, expectedDifferences: [], postScriptDifferences: [], status: 'INCOMPLETE', pass: false };\n129\t  const mismatches = [], expected = [], recorded = [], notes = [];\n130\t  for (const name of tamperSigns) mismatches.push({ check: 'native', detail: `${name} is not native in the page world` });\n131\t  for (const k of Object.keys(VECTOR)) if (canon(page.vector[k]) !== canon(probe.vector[k])) mismatches.push({ check: k, detail: `page world ${canon(page.vector[k])}, probe world ${canon(probe.vector[k])}` });\n132\t  if (canon(page.content) !== canon(probe.content)) mismatches.push({ check: 'content', detail: 'page world and probe world see different content' });\n133\t  const roles = [handoff?.settings?.roles?.qaGate, handoff?.settings?.roles?.approver].filter(nonempty);\n134\t  const explain = check => (Array.isArray(handoff?.jsOffDifferences) ? handoff.jsOffDifferences : []).find(d => d?.check === check && d.screen === scope.screen && d.state === scope.state && d.lang === scope.lang && nonempty(d.reason) && roles.includes(d.reviewer));\n135\t  const differences = [];\n136\t  const sameContent = canon(jsOff.content) === canon(probe.content);\n137\t  if (!sameContent) differences.push({ check: 'content', detail: `with JavaScript off the content differs (slots ${jsOff.content.slots.length} vs ${probe.content.slots.length}, headings ${jsOff.content.headings.length} vs ${probe.content.headings.length}, h1 ${jsOff.content.h1} vs ${probe.content.h1}, ${jsOff.content.lang}/${jsOff.content.dir} vs ${probe.content.lang}/${probe.content.dir}; text compared per slot and heading)` });\n138\t  for (const k of Object.keys(VECTOR)) {\n139\t    if (worseOff(k, probe.vector, jsOff.vector)) differences.push({ check: k, detail: `with JavaScript off ${k} is ${canon(jsOff.vector[k])} vs ${canon(probe.vector[k])}` });\n140\t    else if (worseOff(k, jsOff.vector, probe.vector)) recorded.push({ check: k, detail: `the scripted page is worse than JavaScript off (${k}); failed by the main check` });\n141\t  }\n142\t  // R13 N12: JavaScript-off text that could not be contrast-checked at all, where the scripted page could, proves nothing.\n143\t  if (jsOff.vector.contrastChecked === 0 && probe.vector.contrastChecked > 0) notes.push('JavaScript-off contrast coverage is zero; its contrast diagnostic proves nothing');\n144\t  for (const d of differences) { const e = explain(d.check); if (e) expected.push({ ...d, reason: e.reason.trim(), reviewer: e.reviewer }); else mismatches.push({ ...d, source: 'js-off' }); }\n145\t  // R12 M08, R13 N14: non-equivalent JavaScript-off content is never PASS. An unexplained difference is a mismatch;\n146\t  // a reviewed `content` entry is kept as evidence, but the JavaScript-off metrics stay unverified (INCOMPLETE).\n147\t  if (!sameContent) notes.push(explain('content') ? 'JavaScript-off content differs (reviewed waiver recorded); its metrics are unverified' : 'JavaScript-off content is not equivalent; its metrics prove nothing');\n148\t  // A between-world or native mismatch (a tampering sign) outranks INCOMPLETE; both fail.\n149\t  const status = mismatches.some(m => m.source !== 'js-off') ? 'integrity mismatch' : notes.length ? 'INCOMPLETE' : mismatches.length ? 'integrity mismatch' : 'PASS';\n150\t  return { ...base, mismatches, incomplete: notes, expectedDifferences: expected, postScriptDifferences: recorded, status, pass: status === 'PASS' };\n151\t}\n152\t"}]},"parent_tool_use_id":null,"session_id":"8f80f814-38ed-4ed2-80fc-18e1bfbe6740","uuid":"be71315b-a839-47e4-b9f6-063bddee2be6","timestamp":"2026-10-18T03:24:38.576Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/panel-r14/fannan/release/tools/integrity.mjs","content":"// R11 panel D1 (decisions C and T4), R12 M06-M08/M13/M17/M21: probe-integrity cross-checks for pre-handoff-check.mjs.\n// The authoritative probes and axe run in the isolated probe world (probe-world.mjs: a CDP isolated world with its\n// own globals and prototypes; Playwright has no public isolated-world evaluate, so CDP Page.createIsolatedWorld is\n// used directly, Chromium only). On the positional page and on every declared state, three cross-checks run:\n//  1. page world vs probe world: the full hard-fail vector (VECTOR) evaluated in the page's own world. A page that\n//     patches the browser functions changes only its own world, so any difference is a tampering sign.\n//  2. native functions: the page world's probe functions must still be native code (heuristic; a page can hide a\n//     patch from Function.prototype.toString, which is why check 1 exists).\n//  3. a JavaScript-off pass (javaScriptEnabled: false), diagnostic. First the content must be equivalent (the same\n//     visible copy slots, h1 count, lang and dir); otherwise the diagnostic is INCOMPLETE and fails. Then every field\n//     of the vector where the page with scripts off is worse fails, unless the handoff's `jsOffDifferences` records\n//     that check for this screen, state and lang with a reason and a qaGate/approver reviewer.\n// A vector that is missing a field or holds a non-finite or negative count is INCOMPLETE (never PASS). Contrast is a\n// diagnostic computed by contrastProbe (axe does not complete with page scripts disabled in Chrome 155).\n// R13 (panel round 13, threat model in release/FANNAN-PLAN.md): the vector is the canonical gate result (N11: every\n// hard-fail input, per-width maps, ratios and scrolled-viewport accent; N12: contrast unknown and coverage), the\n// content record carries slot and heading text (N13), a content difference is never PASS even with a reviewed\n// waiver (N14: INCOMPLETE), tamperSigns is required (N19) and call/apply/bind/Reflect.apply are native-checked (N17).\n// Browser side, page world: returns the names of probe functions that are no longer native.\nexport function nativeCheck() {\n  const toString = Function.prototype.toString;\n  const native = f => { try { return typeof f === 'function' && /\\{\\s*\\[native code\\]\\s*\\}\\s*$/.test(toString.call(f)); } catch { return false; } };\n  const desc = (o, k) => Object.getOwnPropertyDescriptor(o, k);\n  const fns = {\n    'Function.prototype.toString': toString,\n    'window.getComputedStyle': window.getComputedStyle,\n    'Element.prototype.getBoundingClientRect': Element.prototype.getBoundingClientRect,\n    'Range.prototype.getBoundingClientRect': Range.prototype.getBoundingClientRect,\n    'Document.prototype.querySelectorAll': Document.prototype.querySelectorAll,\n    'Element.prototype.querySelectorAll': Element.prototype.querySelectorAll,\n    'Element.prototype.matches': Element.prototype.matches,\n    'Element.prototype.getAttribute': Element.prototype.getAttribute,\n    'Element.prototype.closest': Element.prototype.closest,\n    'Node.prototype.textContent (get)': desc(Node.prototype, 'textContent')?.get,\n    'Element.prototype.scrollWidth (get)': desc(Element.prototype, 'scrollWidth')?.get,\n    'CanvasRenderingContext2D.prototype.fillStyle (set)': desc(CanvasRenderingContext2D.prototype, 'fillStyle')?.set,\n    'Array.prototype.filter': Array.prototype.filter,\n    // R13 N17: the rAF wrapper binds call at install time; patched invocation helpers are a tamper sign as well.\n    'Function.prototype.call': Function.prototype.call,\n    'Function.prototype.apply': Function.prototype.apply,\n    'Function.prototype.bind': Function.prototype.bind,\n    'Reflect.apply': Reflect.apply,\n  };\n  return Object.entries(fns).filter(([, f]) => !native(f)).map(([name]) => name);\n}\n\n// Browser side (probe world): text whose colour against its resolved solid background falls below 4.5:1 (3:1 for\n// large text). Backgrounds with images or non-sRGB colours are counted as unknown, not as passes.\nexport function contrastProbe() {\n  const parse = v => { const m = /^rgba?\\(([\\d.]+),\\s*([\\d.]+),\\s*([\\d.]+)(?:,\\s*([\\d.]+))?\\)$/.exec(v || ''); return m ? [Number(m[1]), Number(m[2]), Number(m[3]), m[4] === undefined ? 1 : Number(m[4])] : null; };\n  const over = (top, under) => top.slice(0, 3).map((c, i) => c * top[3] + under[i] * (1 - top[3])).concat(1);\n  const lum = ([r, g, b]) => [r, g, b].map(c => { c /= 255; return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4; }).reduce((s, c, i) => s + c * [0.2126, 0.7152, 0.0722][i], 0);\n  let failures = 0, unknown = 0, checked = 0;\n  for (const el of document.querySelectorAll('body *')) {\n    if (![...el.childNodes].some(n => n.nodeType === 3 && n.nodeValue.trim())) continue;\n    const c = getComputedStyle(el), r = el.getBoundingClientRect();\n    if (!r.width || !r.height || c.visibility === 'hidden' || c.display === 'none') continue;\n    const layers = []; let known = true;\n    for (let a = el; a; a = a.parentElement) { const s = getComputedStyle(a); if (s.backgroundImage !== 'none') { known = false; break; } const bg = parse(s.backgroundColor); if (!bg) { known = false; break; } if (bg[3] > 0) layers.push(bg); if (bg[3] >= 1) break; }\n    const fg = parse(c.color);\n    if (!known || !fg) { unknown++; continue; }\n    const bg = layers.reverse().reduce((under, top) => over(top, under), [255, 255, 255, 1]);\n    const text = over(fg, bg), [l1, l2] = [lum(text), lum(bg)].sort((x, y) => y - x), ratio = (l1 + 0.05) / (l2 + 0.05);\n    const size = parseFloat(c.fontSize), large = size >= 24 || (size >= 18.66 && Number(c.fontWeight) >= 700);\n    checked++; if (ratio < (large ? 3 : 4.5)) failures++;\n  }\n  return { contrastFailures: failures, contrastUnknown: unknown, contrastChecked: checked };\n}\n\n// Browser side: what makes two renderings equivalent content. R13 N13: each visible copy slot with its normalised\n// visible text, every visible heading with its level and text (open shadow roots included), the h1 count, lang and\n// dir; a JavaScript-off skeleton with empty fixed-size slots is therefore not equivalent.\nexport function contentProbe() {\n  const shown = e => { const r = e.getBoundingClientRect(), c = getComputedStyle(e); return r.width > 0 && r.height > 0 && c.visibility !== 'hidden' && c.display !== 'none'; };\n  const norm = x => (x || '').replace(/\\s+/g, ' ').trim();\n  const all = []; const walk = root => { for (const el of root.querySelectorAll('*')) { all.push(el); if (el.shadowRoot) walk(el.shadowRoot); } }; if (document.body) walk(document.body);\n  const slots = all.filter(e => e.hasAttribute('data-copy-slot') && shown(e)).map(e => [e.getAttribute('data-copy-slot'), norm(e.innerText)]).sort((a, b) => (a[0] + '\\u0000' + a[1]).localeCompare(b[0] + '\\u0000' + b[1]));\n  const headings = all.filter(e => /^H[1-6]$/.test(e.tagName) && shown(e)).map(e => [Number(e.tagName[1]), norm(e.innerText)]);\n  return { slots, headings, h1: all.filter(e => e.tagName === 'H1').length, lang: document.documentElement.lang, dir: getComputedStyle(document.documentElement).direction };\n}\n\n// R12 M13: the r