{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01STvhTnY5hc8xQRjxNDGjV6","type":"tool_result","content":"1\t// pre-handoff-check.mjs: Fannan's Harden gate (project arg, protected external dependencies and executables). Local files only; all network requests blocked.\n2\t// Usage: FANNAN_DEPS=<npm prefix> node pre-handoff-check.mjs <DESIGN.md> <page.html> <evidence-dir> <project>\n3\t// Checks: (1) design.md lint 0 errors, (2) axe-core WCAG 2.0/2.1/2.2 A and AA tags (axe-tags.mjs) with target-size ENABLED, 0 violations,\n4\t// (3) custom WCAG 2.2: 2.4.11 focus not obscured, 2.5.8 targets >= 24x24, reduced motion = no running animation,\n5\t// focus visible on every tab stop, every declared desktop width + 320 px reflow screened, (4) impeccable detect (advisory). Writes evidence.json + screenshot.\n6\timport { readFileSync, existsSync, realpathSync, mkdtempSync, rmSync } from 'node:fs';\n7\timport { tmpdir } from 'node:os';\n8\timport { createHash } from 'node:crypto';\n9\timport { execFileSync } from 'node:child_process';\n10\timport { pathToFileURL, fileURLToPath } from 'node:url';\n11\timport { dirname, join, resolve } from 'node:path';\n12\timport { checkHandoff, qualityChecks } from './handoff-contract.mjs';\n13\timport { verifiedDeps } from './verify-deps.mjs';\n14\timport { localAsset } from './local-file-boundary.mjs';\n15\timport { copySignals } from './copy-signals.mjs';\n16\timport { verifiedBrowser, browserLaunchEnv } from './executable-trust.mjs';\n17\timport { focusSettle, focusStyleProbe, focusBaseline } from './focus-screen.mjs';\n18\timport { spacingProbe, approvedSpacing, approvedAccent } from './spacing-scale.mjs';\n19\timport { designProbe, rawGlass, normColour, accentCheck } from './design-probe.mjs';\n20\timport { screenWidths, resolveReflowCandidates, validWidths } from './width-screen.mjs'; // R8, ported from codex/fannan-r3-review 2733317\n21\timport { axeOptions } from './axe-tags.mjs';\n22\timport { isolatedPage } from './probe-world.mjs';\n23\timport { nativeCheck, compareIntegrity, contrastProbe, contentProbe, rafCounterInit, rafLoopFrom } from './integrity.mjs';\n24\timport { scopeOf, resolveScoped } from './exceptions.mjs';\n25\tconst here = dirname(fileURLToPath(import.meta.url));\n26\tconst [, , designMd, page, outDir, project, handoffPath, phaseArg] = process.argv;\n27\tif (!designMd || !page || !outDir || !project || !handoffPath || (phaseArg && !['--phase=wireframe', '--phase=handoff'].includes(phaseArg))) { console.error('usage: FANNAN_DEPS=<npm prefix> node pre-handoff-check.mjs <DESIGN.md> <page.html> <evidence-dir> <project> <handoff.json> [--phase=wireframe|handoff]'); process.exit(2); }\n28\tconst phase = phaseArg?.split('=')[1] || 'handoff';\n29\tconst q = qualityChecks.thresholds;\n30\tconst [nodeMajor, nodeMinor] = process.versions.node.split('.').map(Number);\n31\tif (nodeMajor < 22 || (nodeMajor === 22 && nodeMinor < 12)) { console.error('pre-handoff-check: Node 22.12+ is required (package.json engines); found ' + process.versions.node); process.exit(2); }\n32\t// npm deps live in protected storage OUTSIDE the manifest-covered tree (N2).\n33\tconst releaseRoot = realpathSync(join(here, '..'));\n34\tlet depsRoot;\n35\ttry { depsRoot = verifiedDeps(process.env.FANNAN_DEPS, releaseRoot); }\n36\tcatch (e) { console.error('pre-handoff-check: dependencies untrusted: ' + e.message); process.exit(2); }\n37\tlet chromium;\n38\ttry { ({ chromium } = await import(pathToFileURL(join(depsRoot, 'node_modules/playwright-core/index.mjs')).href)); }\n39\tcatch (e) { console.error('pre-handoff-check: playwright-core missing from FANNAN_DEPS: ' + e.message); process.exit(2); }\n40\t// A fresh evidence directory prevents clobbering an earlier review; each output uses safe-write.\n41\tif (existsSync(outDir)) { console.error('pre-handoff-check: evidence directory already exists; use a fresh versioned path'); process.exit(2); }\n42\tconst evidenceWrite = (name, value) => execFileSync(join(here, 'safe-write.sh'), [project, join(resolve(outDir), name)], { input: value });\n43\tconst digest = value => createHash('sha256').update(value).digest('hex');\n44\ttry { execFileSync(join(here, 'readonly-precheck.sh'), [resolve(outDir) + '/evidence.json', project], { encoding: 'utf8' }); }\n45\tcatch (e) { console.error('pre-handoff-check: readonly-precheck refused the evidence folder: ' + String(e.stderr || e.message).trim()); process.exit(2); }\n46\tconst ev = { when: new Date().toISOString(), designMd: resolve(designMd), page: resolve(page), checks: {} };\n47\tlet fail = false;\n48\tlet handoff;\n49\ttry { handoff = JSON.parse(readFileSync(handoffPath, 'utf8')); ev.checks.contract = { errors: checkHandoff(handoff, phase) }; }\n50\tcatch (e) { ev.checks.contract = { errors: [`handoff JSON cannot be read: ${e.message}`] }; }\n51\tev.checks.contract.pass = ev.checks.contract.errors.length === 0;\n52\tif (!ev.checks.contract.pass) fail = true;\n53\t// CODEX-R3-02: the approved spacing scale comes from the hash-checked handoff token JSON, never from the page.\n54\tconst approvedScale = approvedSpacing(handoff);\n55\tev.checks.spacingTokens = { source: approvedScale.source ?? null, values: approvedScale.values, error: approvedScale.error, pass: !approvedScale.error };\n56\tif (phase === 'handoff' && !ev.checks.spacingTokens.pass) fail = true;\n57\t// R11 panel D1 (decision A): the accent must be the approved palette token; FAIL at handoff, DEFERRED in wireframes.\n58\tconst approvedAccentToken = approvedAccent(handoff);\n59\tconst accentFor = async (pg, d) => accentCheck({ design: d, approved: approvedAccentToken, pageColour: await pg.evaluate(normColour, d.accent), approvedColour: approvedAccentToken.value ? await pg.evaluate(normColour, approvedAccentToken.value) : null, phase });\n60\t// 1 lint\n61\ttry {\n62\t  const r = execFileSync(process.execPath, [join(depsRoot, 'node_modules/@google/design.md/dist/index.js'), 'lint', designMd], { encoding: 'utf8' });\n63\t  const j = JSON.parse(r.slice(r.indexOf('{'))); const errors = j.summary?.errors ?? j.errors ?? null;\n64\t  ev.checks.lint = { errors, pass: errors === 0 }; if (errors !== 0) fail = true;\n65\t} catch (e) { ev.checks.lint = { pass: false, error: String(e.stdout || e.message).slice(0, 400) }; fail = true; }\n66\t// 2-3 browser checks\n67\tlet axeSrc;\n68\ttry { axeSrc = readFileSync(join(depsRoot, 'node_modules/axe-core/axe.min.js'), 'utf8'); }\n69\tcatch (e) { console.error('pre-handoff-check: axe-core missing from FANNAN_DEPS: ' + e.message); process.exit(2); }\n70\tconst browserHome = mkdtempSync(join(tmpdir(), 'fannan-browser-home-')); // ARGON-R2-06: private HOME, removed on exit\n71\tprocess.on('exit', () => rmSync(browserHome, { recursive: true, force: true }));\n72\tlet browserIdentity;\n73\ttry { browserIdentity = verifiedBrowser(); }\n74\tcatch (e) { console.error('pre-handoff-check: browser untrusted: ' + e.message); process.exit(2); }\n75\tconst b = await chromium.launch({ executablePath: browserIdentity.path, chromiumSandbox: true, env: browserLaunchEnv(browserHome) });\n76\tconst runtimeVersion = b.version();\n77\tif (runtimeVersion !== browserIdentity.version) { console.error(`pre-handoff-check: browser version ${runtimeVersion} does not match reviewed pin ${browserIdentity.version}`); await b.close(); process.exit(2); } // R4-4\n78\tev.browser = { ...browserIdentity, version: runtimeVersion };\n79\tconst ctx = await b.newContext({ viewport: { width: 1440, height: 900 }, serviceWorkers: 'block' });\n80\tawait ctx.routeWebSocket(/.*/, ws => ws.close());\n81\tconst blocked = [];\n82\tconst OUTPUT_BASE = '/workspace/design-output';\n83\tconst projectRoot = join(OUTPUT_BASE, project);\n84\tconst glassFiles = new Set(); // R11 S2: served CSS/HTML that declares a backdrop filter (Chrome drops the -webkit- alias)\n85\t// R11: served CSS, HTML, SVG and JavaScript text (constructed sheets and script-set styles; Chrome drops the -webkit- alias when parsing)\n86\tconst scanGlass = (path, contentType, body) => { if (/text\\/(css|html|javascript)|application\\/(javascript|ecmascript)|image\\/svg\\+xml/.test(contentType) && rawGlass(body.toString('utf8'), /text\\/css/.test(contentType) ? 'css' : 'script')) glassFiles.add(path); }; // R12 M04: script forms in HTML/JS/SVG\n87\tconst served = new Set(); // R13 N07: URLs whose bytes the checker served and scanned\n88\tconst routeLocal = async r => { const u = r.request().url(); try { const asset = localAsset(u, projectRoot); scanGlass(asset.path, asset.contentType, asset.body); served.add(u); await r.fulfill({ body: asset.body, contentType: asset.contentType }); } catch (e) { blocked.push({ url: u, reason: e.message }); await r.abort(); } };\n89\tawait ctx.route('**/*', routeLocal);\n90\tconst p = await isolatedPage(await ctx.newPage()); // R11 C3: probes and axe run in an isolated world\n91\tconst ready = page => page.evaluate(async () => { await document.fonts.ready; const brokenImages = []; await Promise.all([...document.images].map(async img => { try { await img.decode(); } catch { brokenImages.push(img.currentSrc || img.src); } })); return { brokenImages, failedFonts: [...document.fonts].filter(f => f.status === 'error').map(f => f.family) }; });\n92\tawait p.goto(pathToFileURL(resolve(page)).href); const firstAssets = await ready(p); await p.addScriptTag({ content: axeSrc });\n93\tev.checks.assets = { ...firstAssets, pass: firstAssets.brokenImages.length === 0 && firstAssets.failedFonts.length === 0 };\n94\tif (!ev.checks.assets.pass) fail = true;\n95\tconst copyProbe = (page, st) => page.evaluate(({ slots, lang, dir }) => {\n96\t  const norm = x => (x || '').replace(/\\s+/g, ' ').trim();\n97\t  const wanted = new Map(slots.map(c => [c.id, norm(c.variants?.find(v => v.lang === lang && v.dir === dir)?.text || c.text)]));\n98\t  const errors = [], used = new Set();\n99\t  // R13 N20: the composed tree (open shadow roots included); slots are found through composed ancestors.\n100\t  const texts = [], elements = [];\n101\t  const walk = root => { const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT); while (w.nextNode()) { const n = w.currentNode; if (n.nodeType === 3) texts.push(n); else { elements.push(n); if (n.shadowRoot) walk(n.shadowRoot); } } };\n102\t  walk(document.body);\n103\t  const parentOf = el => el.assignedSlot ?? el.parentElement ?? (el.getRootNode() instanceof ShadowRoot ? el.getRootNode().host : null);\n104\t  const slotOf = el => { for (let a = el; a; a = parentOf(a)) if (a.hasAttribute?.('data-copy-slot')) return a; return null; };\n105\t  for (const n of texts) {\n106\t    const value = norm(n.nodeValue);\n107\t    if (!value || ['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(n.parentElement?.tagName)) continue;\n108\t    const style = getComputedStyle(n.parentElement), range = document.createRange(); range.selectNodeContents(n);\n109\t    if (style.display === 'none' || style.visibility === 'hidden' || range.getClientRects().length === 0) continue;\n110\t    const el = slotOf(n.parentElement), id = el?.getAttribute('data-copy-slot');\n111\t    if (!id || !wanted.has(id)) { errors.push(`unlisted visible copy: ${value.slice(0, 60)}`); continue; }\n112\t    used.add(id);\n113\t  }\n114\t  for (const [id, text] of wanted) {\n115\t    const matches = elements.filter(e => e.getAttribute('data-copy-slot') === id);\n116\t    if (matches.length !== 1 || norm(matches[0].textContent) !== text) errors.push(`copy slot ${id} differs from deck`);\n117\t    if (!used.has(id)) errors.push(`copy slot ${id} not visible`);\n118\t  }\n119\t  return { errors, pass: errors.length === 0 };\n120\t}, { slots: (handoff?.copySlots || []).filter(c => c.screen === st.screen && c.placements?.some(p => p.lang === st.lang && p.state === st.state)), lang: st.lang, dir: st.dir });\n121\tconst design = { ...await p.evaluate(designProbe), ...await p.evaluate(spacingProbe, approvedScale.values) }; // OPUS-R2-10\n122\tObject.assign(design, copySignals(design.visibleText, design.headlines));\n123\tdelete design.visibleText; delete design.headlines;\n124\tev.checks.design = { ...design, basis: 'DOM background-area proxy; overlapping backgrounds may double count; screenshots and state-bound manual review required', pass: design.centered <= q.centeredSectionsPerPage && (phase === 'wireframe' || (design.typeSizes.length <= q.typeSizes && design.accentRatio !== null && design.accentRatio <= q.accentAreaRatioFullPage && design.accentViewportRatio !== null && design.accentViewportRatio <= q.accentAreaRatioViewport)) && !design.heroGradient && design.glass <= q.stockGlass && design.iconRows <= q.centeredThreeIconRows && !design.purpleBlue && !design.filler && !design.ruleOfThree && (phase === 'wireframe' || !design.placeholders) && (phase === 'wireframe' || design.spacingOffScale.length <= q.spacingOffScale) && design.h1 === 1 };\n125\tif (!ev.checks.design.pass) fail = true;\n126\tev.checks.accent = await accentFor(p, design);\n127\tif (!ev.checks.accent.pass) fail = true;\n128\t// R12 M03: probes and axe run in the main frame only, so any frame (readable or not) blocks the final handoff.\n129\tconst framesCheck = d => ({ frames: d.glassScopes.frames + d.glassScopes.unscannedFrames.length, unscanned: d.glassScopes.unscannedFrames, status: phase === 'wireframe' ? 'DEFERRED' : d.glassScopes.frames + d.glassScopes.unscannedFrames.length ? 'FAIL' : 'PASS', note: 'axe and the probes do not run inside frames', pass: phase === 'wireframe' || d.glassScopes.frames + d.glassScopes.unscannedFrames.length === 0 });\n130\tev.checks.frames = framesCheck(design);\n131\tif (!ev.checks.frames.pass) fail = true;\n132\t// R13 N07: data:/blob: stylesheets are refused, and a stylesheet whose rules could not be read and whose bytes the\n133\t// checker did not serve and scan is unscanned; both fail (glass is gated in both phases).\n134\tconst sheetsCheck = d => { const list = d.stylesheets || [], refused = list.filter(x => /^(data|blob):/i.test(x.href || '')), unscanned = list.filter(x => !x.readable && !refused.includes(x) && !(x.href && served.has(x.href))); return { sheets: list.length, refused: refused.map(x => (x.href || '').slice(0, 80)), unscanned: unscanned.map(x => x.href || x.owner), pass: refused.length === 0 && unscanned.length === 0 }; };\n135\tev.checks.stylesheets = sheetsCheck(design);\n136\tif (!ev.checks.stylesheets.pass) fail = true;\n137\t// R12 M07/M09/M20: the positional page is scoped by its declared state (screen, state, lang).\n138\tconst declaredStates = (handoff?.screens || []).flatMap(s => (s.states || []).filter(st => st.applicable !== false).map(st => ({ screen: s.id, ...st })));\n139\tconst pageScope = scopeOf(declaredStates.find(st => st.page && resolve(st.page) === resolve(page)));\n140\tconst axe = await p.evaluate(async options => axe.run(document, options), axeOptions()); // R11 C1: WCAG 2.0-2.2 A and AA\n141\tev.checks.axe = { version: axe.testEngine.version, targetSizeEnabled: true, violations: axe.violations.map(v => ({ id: v.id, impact: v.impact, nodes: v.nodes.length })), incomplete: axe.incomplete.map(v => v.id), pass: axe.violations.length === 0 && axe.incomplete.length === 0 };\n142\tif (!ev.checks.axe.pass) fail = true;\n143\t// custom: tab through, check focus visible, not obscured by fixed/sticky elements, target size\n144\tawait p.evaluate(() => { window.__fid = new WeakMap(); window.__fnext = 0; });\n145\tconst stops = []; const seen = new Set();\n146\tawait p.evaluate(focusBaseline); await p.evaluate(focusStyleProbe, { capture: true }); // ARGON-R2-05: one unfocused baseline\n147\tfor (let i = 0; i < 200; i++) {\n148\t  await p.keyboard.press('Tab');\n149\t  await p.evaluate(focusSettle);\n150\t  const focusVisible = await p.evaluate(focusStyleProbe, { minContrast: q.focusStateContrast });\n151\t  const info = await p.evaluate(() => {\n152\t    const el = document.activeElement; if (!el || el === document.body) 