(Boolean)) { try { scanGlass(resolve(file), 'text/html', readFileSync(resolve(file))); } catch {} }\n292\tev.checks.glassSource = { files: [...glassFiles], pass: glassFiles.size === 0 };\n293\tif (!ev.checks.glassSource.pass) fail = true;\n294\t// 4 impeccable detect: findings are advisory, but it MUST run and return parseable output\n295\t{\n296\t  let out = '', status = 0;\n297\t  try { out = execFileSync(join(here, 'launcher-impeccable.sh'), ['detect', '--json', page], { encoding: 'utf8', env: { PATH: '/usr/bin:/bin', FANNAN_PROJECT: project } }); }\n298\t  catch (e) { out = String(e.stdout || ''); status = e.status; }\n299\t  let findings = null; try { const j = JSON.parse(out); if (Array.isArray(j)) findings = j; } catch {}\n300\t  if (findings === null || (status !== 0 && status !== 2)) { ev.checks.impeccable = { ran: false, exit: status, pass: false, note: 'detect did not run or gave no parseable output' }; fail = true; }\n301\t  else ev.checks.impeccable = { ran: true, exit: status, advisory: true, findings: findings.map(f => f.antipattern || f.name), pass: true };\n302\t}\n303\tev.phase = phase;\n304\tev.pass = !fail;\n305\tev.handoffReady = ev.pass && phase === 'handoff';\n306\tevidenceWrite('evidence.json', JSON.stringify(ev, null, 1));\n307\tif (ev.handoffReady) {\n308\t  const rows = handoff.screens.flatMap(s => s.acceptance.map(a => `| ${s.id} | ${a.id} | ${a.severity} | ${a.decision} | ${a.check.replaceAll('|', '\\\\|')} | ${a.evidence} |`));\n309\t  const frames = handoff.screens.flatMap(s => s.states.filter(st => st.applicable !== false).map(st => `| ${s.id} | ${st.lang} | ${st.state} | ${st.frame.version} | ${st.frame.sha256} | ${st.frame.path} |`));\n310\t  const checklist = ['# Design and QA handoff', '', `Project: ${project}`, `Engineer: ${handoff.settings.roles.engineer}`, `QA gate: ${handoff.settings.roles.qaGate}`, `Writer: ${handoff.settings.roles.writer}`, `Approver: ${handoff.settings.roles.approver}`, `Approval record: ${handoff.approval.