   172	def verify_hashes(path, root, digest, exact=None):
   173	    if path.is_symlink() or path.stat().st_mode & 0o222:
   174	        raise ValueError('manifest must be a real read-only file')
   175	    if sha(path) != digest:
   176	        raise ValueError('manifest pin mismatch')
   177	    entries = {}
   178	    for line in path.read_text().splitlines():
   179	        if line.startswith('#'):
   180	            continue
   181	        value, name = line.split('  ', 1)
   182	        if name in entries or Path(name).is_absolute() or '..' in Path(name).parts:
   183	            raise ValueError('invalid or duplicate manifest path')
   184	        item = root / name
   185	        if item.is_symlink() or not item.is_file() or sha(item) != value:
   186	            raise ValueError('manifest bytes mismatch: ' + name)
   187	        entries[name] = value
   188	    if exact is not None and set(entries) != set(exact):
   189	        raise ValueError('manifest inventory mismatch')
   190	    return entries
