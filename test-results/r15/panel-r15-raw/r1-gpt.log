   112	}
   113	
   114	// Node side. The accent fails closed at final handoff: an invalid or missing accent variable, an unreadable approved
   115	// token, or a page accent that is not the approved palette colour FAILS, with a message naming the variable. The
   116	// wireframe phase (grayscale by plan) records DEFERRED, never PASS. The area ratios stay a DOM background-area proxy
   117	// (approximate; screenshot review required) and are gated separately. No interactive-element requirement (panel T1).
   118	export function accentCheck({ design, approved, pageColour, approvedColour, phase }) {
   119	  const base = { variable: design.accentVar, value: design.accent || null, approvedToken: approved?.token ?? null, approvedValue: approved?.value ?? null, areaBasis: 'DOM background-area proxy: approximate; overlapping or transformed boxes are not pixel-measured' };
   120	  let message = null;
   121	  if (design.accentInvalid?.length) message = `accent variable ${design.accentInvalid.join(', ')} is not a valid colour`;
   122	  else if (!design.accentVar) message = 'no accent variable declared (--accent, --colors-accent or --colors-primary)';
   123	  else if (approved?.error || !approved?.value) message = `approved accent token unavailable: ${approved?.error || 'missing'}`;
   124	  else if (!approvedColour) message = `approved accent token ${approved.token} (${approved.value}) is not a valid colour`;
   125	  else if (pageColour !== approvedColour) message = `accent variable ${design.accentVar} (${design.accent}) does not match the approved token ${approved.token} (${approved.value})`;
   126	  if (phase === 'wireframe') return { ...base, status: 'DEFERRED', message: message ?? 'accent identity deferred to the styled handoff', pass: true };
   127	  return { ...base, status: message ? 'FAIL' : 'PASS', message, pass: !message };
   128	}
