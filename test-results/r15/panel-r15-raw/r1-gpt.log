   154	def write_bytes(path, data, readonly=False):
   155	    """CODEX-R4-01: write a sibling temp file, then os.replace it, so an interrupted write never truncates the old output."""
   156	    path.parent.mkdir(parents=True, exist_ok=True)
   157	    fd, temp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
   158	    try:
   159	        with os.fdopen(fd, 'wb') as handle:
   160	            handle.write(data)
   161	        os.chmod(temp, 0o444 if readonly else 0o644)
   162	        os.replace(temp, path)
   163	    except BaseException:
   164	        Path(temp).unlink(missing_ok=True)
   165	        raise
